<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    
    <!-- Permissions -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.SET_WALLPAPER"/>
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>
    <uses-permission android:name="android.permission.VIBRATE"/>
    
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <category android:name="android.intent.category.BROWSABLE"/>
            <data android:scheme="https"/>
        </intent>
    </queries>
    
    <application 
        android:name=".MainApplication" 
        android:label="@string/app_name" 
        android:icon="@mipmap/ic_launcher" 
        android:roundIcon="@mipmap/ic_launcher_round" 
        android:allowBackup="true" 
        android:theme="@style/AppTheme" 
        android:supportsRtl="true" 
        android:enableOnBackInvokedCallback="false" 
        android:requestLegacyExternalStorage="true">
        
        <!-- Expo metadata -->
        <meta-data android:name="expo.modules.updates.ENABLED" android:value="false"/>
        <meta-data android:name="expo.modules.updates.EXPO_UPDATES_CHECK_ON_LAUNCH" android:value="ALWAYS"/>
        <meta-data android:name="expo.modules.updates.EXPO_UPDATES_LAUNCH_WAIT_MS" android:value="0"/>
        
        <!-- Widget service -->
        <service android:name="com.reactnativeandroidwidget.RNWidgetCollectionService" android:permission="android.permission.BIND_REMOTEVIEWS"/>
        
        <!-- Main activity -->
        <activity 
            android:name=".MainActivity" 
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|uiMode" 
            android:launchMode="singleTask" 
            android:windowSoftInputMode="adjustResize" 
            android:theme="@style/Theme.App.SplashScreen" 
            android:exported="true" 
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="timeapp"/>
                <data android:scheme="exp+timeapp"/>
            </intent-filter>
        </activity>
        
        <!-- Widget receiver -->
        <receiver 
            android:name=".widget.YearProgress" 
            android:exported="false" 
            android:label="Year Progress">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
                <action android:name="com.spritzstudio.dotchrono.WIDGET_CLICK"/>
            </intent-filter>
            <meta-data 
                android:name="android.appwidget.provider" 
                android:resource="@xml/widgetprovider_yearprogress"/>
        </receiver>
        
        <!-- Live Wallpaper Service -->
        <service
            android:name=".DotsLiveWallpaper"
            android:enabled="true"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/live_wallpaper_preview" />
        </service>
        
    </application>
</manifest>
